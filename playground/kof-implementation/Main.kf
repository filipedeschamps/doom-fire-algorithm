initFire(Int[] fire, Int width, Int height, Int maxIntensity) {
    for (var i = 0; i < width * height; i++) {
        fire[i] = 0
    }
    for (var x = 0; x < width; x++) {
        fire[(height - 1) * width + x] = maxIntensity
    }
}

spreadFire(Int[] fire, Int width, Int height, Int src) {
    var x = src % width
    var y = src / width
    var pixel = fire[src]
    if (pixel == 0) {
        fire[(y - 1) * width + x] = 0
    } else {
        var rand = random.randomInt(4)
        var dstX = x - rand + 1
        if (dstX < 0) {
            dstX = 0
        }
        if (dstX >= width) {
            dstX = width - 1
        }
        fire[(y - 1) * width + dstX] = pixel - (rand & 1)
    }
}

doFire(Int[] fire, Int width, Int height) {
    for (var x = 0; x < width; x++) {
        for (var y = 1; y < height; y++) {
            spreadFire(fire, width, height, y * width + x)
        }
    }
}

render(Int[] fire, Int[] paletteR, Int[] paletteG, Int[] paletteB, Int width, Int height): String {
    var out = "[H"
    for (var y = 0; y < height; y++) {
        for (var x = 0; x < width; x++) {
            var idx = fire[y * width + x]
            out = out + "[48;2;" + paletteR[idx] + ";" + paletteG[idx] + ";" + paletteB[idx] + "m  "
        }
        out = out + "[0m\n"
    }
    return out
}

